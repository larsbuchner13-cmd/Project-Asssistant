// PM Copilot — Prisma schema
// Data model covering PMBOK-generic project artifacts plus PRINCE2 and Scrum
// framework-specific extensions selected per project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Framework {
  PMBOK
  PRINCE2
  SCRUM
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum RagStatus {
  RED
  AMBER
  GREEN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StakeholderLevel {
  LOW
  MEDIUM
  HIGH
}

enum EngagementStrategy {
  MONITOR // low power / low interest
  KEEP_INFORMED // low power / high interest
  KEEP_SATISFIED // high power / low interest
  MANAGE_CLOSELY // high power / high interest
}

enum WorkPackageStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

enum RiskStatus {
  OPEN
  MITIGATED
  OCCURRED
  CLOSED
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AssumptionStatus {
  UNVALIDATED
  VALIDATED
  INVALIDATED
}

enum DependencyStatus {
  PENDING
  AT_RISK
  RESOLVED
}

enum ChangeRequestStatus {
  PROPOSED
  APPROVED
  REJECTED
  DEFERRED
  IMPLEMENTED
}

enum KnowledgeArea {
  INTEGRATION
  SCOPE
  SCHEDULE
  COST
  QUALITY
  RESOURCE
  COMMUNICATION
  RISK
  PROCUREMENT
  STAKEHOLDER
}

enum ProcessRunStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProcessStepStatus {
  LOCKED
  READY
  IN_PROGRESS
  DONE
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(USER)
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  projects Project[]

  // Process / Workflow OS
  createdProcessTemplates  ProcessTemplate[]     @relation("ProcessTemplateCreatedBy")
  processStepAssigneeOf    ProcessStepTemplate[] @relation("ProcessStepTemplateAssignee")
  processStepApproverOf    ProcessStepTemplate[] @relation("ProcessStepTemplateApprover")
  startedProcessRuns       ProcessRun[]          @relation("ProcessRunStartedBy")
  processRunStepAssigneeOf ProcessRunStep[]      @relation("ProcessRunStepAssignee")
  processRunStepApproverOf ProcessRunStep[]      @relation("ProcessRunStepApprover")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Core project
// ---------------------------------------------------------------------------

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  framework   Framework
  status      ProjectStatus @default(PLANNING)
  ragStatus   RagStatus     @default(GREEN)
  startDate   DateTime
  endDate     DateTime?
  sponsor     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Initiating
  charter      ProjectCharter?
  stakeholders Stakeholder[]

  // Planning
  workPackages WorkPackage[]
  risks        Risk[]

  // Executing
  tasks     Task[]
  decisions Decision[]

  // Monitoring & Controlling
  statusReports  StatusReport[]
  issues         Issue[]
  assumptions    Assumption[]
  dependencies   Dependency[]
  changeRequests ChangeRequest[]
  milestones     Milestone[]

  // Closing
  lessonsLearned   LessonLearned[]
  closureChecklist ClosureChecklistItem[]

  // Framework-specific extensions
  businessCase BusinessCase?
  tolerance    Prince2Tolerance?
  stageGates   StageGate[]
  backlogItems BacklogItem[]
  sprints      Sprint[]

  // Optional link from a company-wide workflow run to the project it supports
  processRuns ProcessRun[]

  @@index([ownerId, status])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Initiating
// ---------------------------------------------------------------------------

model ProjectCharter {
  id              String   @id @default(cuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  businessCase    String
  objectives      String
  successCriteria String
  highLevelScope  String
  budgetEstimate  Float
  sponsor         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("project_charters")
}

model Stakeholder {
  id                 String             @id @default(cuid())
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  role               String
  influence          StakeholderLevel
  interest           StakeholderLevel
  engagementStrategy EngagementStrategy
  notes              String?
  createdAt          DateTime           @default(now())

  @@index([projectId])
  @@map("stakeholders")
}

// ---------------------------------------------------------------------------
// Planning
// ---------------------------------------------------------------------------

model WorkPackage {
  id             String            @id @default(cuid())
  projectId      String
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         WorkPackage?      @relation("WorkPackageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       WorkPackage[]     @relation("WorkPackageTree")
  name           String
  description    String?
  level          Int               @default(1) // 1-4
  order          Int               @default(0)
  owner          String?
  effortEstimate Float? // person-days
  plannedCost    Float             @default(0)
  actualCost     Float             @default(0)
  startDate      DateTime?
  endDate        DateTime?
  status         WorkPackageStatus @default(NOT_STARTED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tasks         Task[]
  milestones    Milestone[]
  predecessorOf WorkPackageDependency[] @relation("Predecessor")
  successorOf   WorkPackageDependency[] @relation("Successor")

  @@index([projectId, parentId, order])
  @@index([projectId, status])
  @@map("work_packages")
}

model WorkPackageDependency {
  id            String      @id @default(cuid())
  predecessorId String
  predecessor   WorkPackage @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     WorkPackage @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("work_package_dependencies")
}

model Risk {
  id              String     @id @default(cuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String
  probability     Int // 1-5
  impact          Int // 1-5
  status          RiskStatus @default(OPEN)
  mitigationPlan  String?
  contingencyPlan String?
  owner           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([projectId, status])
  @@map("risks")
}

// ---------------------------------------------------------------------------
// Executing
// ---------------------------------------------------------------------------

model Task {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  status        TaskStatus   @default(BACKLOG)
  assignee      String?
  priority      Priority     @default(MEDIUM)
  dueDate       DateTime?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId, status, order])
  @@index([workPackageId])
  @@map("tasks")
}

model Decision {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetingDate  DateTime
  attendees    String[]
  notes        String
  decisionText String
  actionItems  ActionItem[]
  createdAt    DateTime     @default(now())

  @@index([projectId, meetingDate])
  @@map("decisions")
}

model ActionItem {
  id          String    @id @default(cuid())
  decisionId  String
  decision    Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  description String
  owner       String
  dueDate     DateTime?
  done        Boolean   @default(false)

  @@index([decisionId, done])
  @@map("action_items")
}

// ---------------------------------------------------------------------------
// Monitoring & Controlling
// ---------------------------------------------------------------------------

model StatusReport {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  weekOf        DateTime
  ragStatus     RagStatus
  summary       String
  budgetBurnPct Float
  createdAt     DateTime  @default(now())

  @@index([projectId, weekOf])
  @@map("status_reports")
}

model Issue {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description  String
  impact       String?
  status       IssueStatus @default(OPEN)
  owner        String?
  raisedDate   DateTime    @default(now())
  resolvedDate DateTime?

  @@index([projectId, status])
  @@map("issues")
}

model Assumption {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  status      AssumptionStatus @default(UNVALIDATED)
  owner       String?
  createdAt   DateTime         @default(now())

  @@index([projectId, status])
  @@map("assumptions")
}

model Dependency {
  id          String           @id @default(cuid())
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  dependsOn   String // external party / team / project
  status      DependencyStatus @default(PENDING)
  owner       String?
  createdAt   DateTime         @default(now())

  @@index([projectId, status])
  @@map("dependencies")
}

model ChangeRequest {
  id           String              @id @default(cuid())
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description  String
  impactScope  String?
  impactTime   String?
  impactCost   String?
  status       ChangeRequestStatus @default(PROPOSED)
  requestedBy  String?
  decisionDate DateTime?
  createdAt    DateTime            @default(now())

  @@index([projectId, status])
  @@map("change_requests")
}

model Milestone {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String?
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  name          String
  dueDate       DateTime
  achieved      Boolean      @default(false)

  @@index([projectId, dueDate])
  @@index([workPackageId])
  @@map("milestones")
}

// ---------------------------------------------------------------------------
// Closing
// ---------------------------------------------------------------------------

model LessonLearned {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  whatWentWell    String?
  whatDidnt       String?
  recommendations String?
  knowledgeArea   KnowledgeArea
  createdAt       DateTime      @default(now())

  @@index([projectId])
  @@map("lessons_learned")
}

model ClosureChecklistItem {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  category  String
  done      Boolean @default(false)
  order     Int     @default(0)

  @@index([projectId, order])
  @@map("closure_checklist_items")
}

// ---------------------------------------------------------------------------
// PRINCE2 extensions
// ---------------------------------------------------------------------------

model BusinessCase {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reasons             String
  options             String
  expectedBenefits    String
  expectedDisBenefits String?
  costsSummary        String
  majorRisks          String?
  updatedAt           DateTime @updatedAt

  @@map("business_cases")
}

model Prince2Tolerance {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  time      String?
  cost      String?
  scope     String?
  risk      String?
  quality   String?
  benefits  String?

  @@map("prince2_tolerances")
}

model StageGate {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  endDate   DateTime
  checklist Json // [{ label: string, done: boolean }]
  approved  Boolean  @default(false)
  order     Int      @default(0)

  @@index([projectId, order])
  @@map("stage_gates")
}

// ---------------------------------------------------------------------------
// Scrum extensions
// ---------------------------------------------------------------------------

model BacklogItem {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  title       String
  description String?
  storyPoints Int?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(BACKLOG)
  order       Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([projectId, status, order])
  @@index([sprintId, order])
  @@map("backlog_items")
}

model Sprint {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime
  endDate   DateTime
  items     BacklogItem[]

  @@index([projectId, startDate])
  @@map("sprints")
}

// ---------------------------------------------------------------------------
// Process / Workflow OS — company-wide (not owner-scoped like Project).
// Every active user can see every template and every run, matching the
// "one system everyone works from" requirement. A template is a reusable
// blueprint (ordered steps, each with a responsible party, an optional
// approval gate, and a checklist); starting a run snapshots the template's
// steps so later template edits never rewrite in-flight or historical runs.
// ---------------------------------------------------------------------------

model ProcessTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ProcessTemplateCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps ProcessStepTemplate[]
  runs  ProcessRun[]

  @@index([createdById, isActive])
  @@map("process_templates")
}

model ProcessStepTemplate {
  id               String          @id @default(cuid())
  templateId       String
  template         ProcessTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  order            Int             @default(0)
  responsibleRole  String? // free-text role/department, e.g. "Buchhaltung"
  assigneeId       String?
  assignee         User?           @relation("ProcessStepTemplateAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requiresApproval Boolean         @default(false)
  approverId       String?
  approver         User?           @relation("ProcessStepTemplateApprover", fields: [approverId], references: [id], onDelete: SetNull)
  targetDays       Float? // expected duration in days, used as a KPI target

  checklistItems ProcessChecklistTemplateItem[]
  runSteps       ProcessRunStep[]

  @@index([templateId, order])
  @@index([assigneeId])
  @@index([approverId])
  @@map("process_step_templates")
}

model ProcessChecklistTemplateItem {
  id     String              @id @default(cuid())
  stepId String
  step   ProcessStepTemplate @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label  String
  order  Int                 @default(0)

  @@index([stepId, order])
  @@map("process_checklist_template_items")
}

model ProcessRun {
  id          String           @id @default(cuid())
  templateId  String
  template    ProcessTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  status      ProcessRunStatus @default(ACTIVE)
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startedById String
  startedBy   User             @relation("ProcessRunStartedBy", fields: [startedById], references: [id], onDelete: Cascade)
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  steps ProcessRunStep[]

  @@index([templateId, status])
  @@index([projectId])
  @@index([startedById, startedAt])
  @@index([status, startedAt])
  @@map("process_runs")
}

// Snapshot of a ProcessStepTemplate at run-start time, plus live progress.
model ProcessRunStep {
  id               String               @id @default(cuid())
  runId            String
  run              ProcessRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepTemplateId   String?
  stepTemplate     ProcessStepTemplate? @relation(fields: [stepTemplateId], references: [id], onDelete: SetNull)
  order            Int
  name             String
  description      String?
  responsibleRole  String?
  assigneeId       String?
  assignee         User?                @relation("ProcessRunStepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status           ProcessStepStatus    @default(LOCKED)
  requiresApproval Boolean              @default(false)
  approverId       String?
  approver         User?                @relation("ProcessRunStepApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvalStatus   ApprovalStatus       @default(NOT_REQUIRED)
  approvalComment  String?
  approvedAt       DateTime?
  targetDays       Float?
  startedAt        DateTime?
  completedAt      DateTime?

  checklistItems ProcessRunChecklistItem[]

  @@index([runId, order])
  @@index([assigneeId, status])
  @@index([approverId, approvalStatus])
  @@index([stepTemplateId])
  @@map("process_run_steps")
}

model ProcessRunChecklistItem {
  id        String         @id @default(cuid())
  runStepId String
  runStep   ProcessRunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  label     String
  order     Int            @default(0)
  done      Boolean        @default(false)
  doneAt    DateTime?

  @@index([runStepId, order])
  @@map("process_run_checklist_items")
}
