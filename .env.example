# Pooled connection (has "-pooler" in the hostname) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-example-000000-pooler.eu-central-1.aws.neon.tech/pmcopilot?sslmode=require"

# Direct/unpooled connection (no "-pooler") — used only by `prisma migrate` /
# `prisma db seed`. Neon's pooled connection uses PgBouncer in transaction
# mode, which doesn't support the advisory locks Prisma Migrate needs, so a
# direct connection is required for migrations.
DIRECT_URL="postgresql://user:password@ep-example-000000.eu-central-1.aws.neon.tech/pmcopilot?sslmode=require"

# NextAuth — used to sign/encrypt session JWTs. Generate one with
# `openssl rand -base64 32` and keep it secret in production.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Required in production (and recommended in dev): the canonical URL this
# app is served from. NextAuth uses it to build callback/redirect URLs.
NEXTAUTH_URL="http://localhost:3000"
